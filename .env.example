# Heart to Heart — environment variable TEMPLATE. Copy values from your own secret stores; NEVER commit real values.

# --- Netlify BUILD variable (required to build the site) ---
# The project's PUBLIC anon key (safe for browsers; it is embedded in the built form). Without it the build fails.
H2H_PUBLIC_ANON_KEY=

# --- Supabase Edge Function secrets (set with the Supabase dashboard/MCP; the function reads them at run time) ---
# submit-enrollment
H2H_APP_DATA_KEY=            # base64, 32 random bytes: application-level AES-256-GCM key for data and PDFs
H2H_RESEND_API_KEY=          # Resend key; a key that can also READ emails lets delivery be verified, a send-only key records "unverifiable"
H2H_ADMIN_SECRET=            # authorizes /admin (retry, status, authorized PDF download); never public
H2H_DIRECTOR_EMAIL=          # staff TO address (default hearttoheart3095@yahoo.com)
H2H_STAFF_BCC=               # staff BCC address (default tohearts25@gmail.com)
H2H_REPLY_TO=                # optional
H2H_FROM_EMAIL=              # verified Resend sender
H2H_ALLOWED_ORIGIN=https://hearts25.com
H2H_FONT_BASE=https://hearts25.com/assets/fonts/
H2H_RESEND_URL=              # optional override (tests)
H2H_SWEEP_MIN_AGE=120        # seconds before an unfinished application is retried by the sweep
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to Edge Functions by Supabase.

# --- Vault secret used by the pg_cron sweep (create with SQL; do not commit) ---
# name: h2h_public_anon_key   value: the public anon key
