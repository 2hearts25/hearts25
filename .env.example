# Heart to Heart Enrichment Center - environment variable template.
# Copy to .env for local use. NEVER commit real values.
# The static site build (node build.mjs) needs NO environment variables.

# --- Supabase Edge Function secrets (set in the Supabase dashboard:
#     Project -> Edge Functions -> Secrets; never in the browser) ---
# Supabase injects SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY automatically
# for hosted Edge Functions. Set them yourself only for local testing.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend sending-only API key for the heart-to-heart domain (hearts25.com).
H2H_RESEND_API_KEY=
# Sender and staff alert address (defaults shown are compiled into the code).
H2H_FROM_EMAIL="Heart to Heart Enrichment Center <hello@hearts25.com>"
H2H_STAFF_NOTIFY_EMAIL=tohearts25@gmail.com

# Shared secret (32+ random characters) used by the Netlify Forms outgoing
# webhook that calls the tour-request-mailer function.
H2H_TOUR_SHARED_SECRET=

# --- Deployment tooling (only for CLI deploys; keep out of git) ---
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
